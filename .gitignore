# ---- 大体积的本地构建产物，不要提交到 GitHub ----
# 便携版 .NET SDK（约 300MB）
_src/dotnet/
_src/tools/
_src/*.zip
_src/*.tar
_src/*.tar.gz
_src/extract/
_src/*.log
# 官方原始源码的副本（约 500KB，仅供本地 diff 对比）
_src/tree/
# 自动化测试用的临时构建目录（里面是编译产物，不是源码）
_src/test/build/

# ---- 编译输出 ----
bin/
obj/
work/bin/
work/obj/
work/SAM.API/bin/
work/SAM.API/obj/
work/SAM.Game/bin/
work/SAM.Game/obj/
work/SAM.Picker/bin/
work/SAM.Picker/obj/
work/upload/
upload/

# ---- 编译好的二进制（仓库只保留源码，二进制通过 Releases 分发）----
# 注意：下面的规则只作用于仓库根目录，不会影响 work/ 里的源码
/*.exe
/*.dll
/*.pdb
# 运行时依赖的第三方 dll 同样不入库
/System.*.dll

# ---- 调试与临时文件 ----
*.pdb
*_wpftmp.csproj
.vs/
.vscode/
.idea/
*.user
*.suo

# ---- 原版二进制备份 ----
original-backup/

# ---- 截图（调试产物，不入库）----
_shots/
_shots2/

# ---- 本程序运行时生成的进度存档 ----
spread-*.json

# ---- 发布打包目录与临时凭据（绝不入库）----
_src/release/
_src/gh-token.txt
_src/poll.ps1
_src/device-code.json

# ---- 本程序运行时生成的用户配置 ----
sam-mod-config.txt
